{
  "manifest_version": 3,
  "name": "Wavely 1688 采集助手",
  "short_name": "Wavely 采集",
  "version": "0.1.1",
  "description": "在 1688 列表页勾选商品、在详情页一键采集，写入 Wavely 跨境 ERP 的采集箱。",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Wavely 1688 采集助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://*.1688.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.1688.com/*"
      ],
      "exclude_matches": [
        "https://login.1688.com/*",
        "https://passport.1688.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://xiaozhuangping-cpu.github.io/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
